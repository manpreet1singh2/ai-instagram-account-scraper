# ═══════════════════════════════════════════════════════
#  AI Instagram Intelligence — Backend Environment
# ═══════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME="IG Intelligence API"

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://iguser:StrongPass@2025@localhost:5432/instagram_intel
POSTGRES_USER=iguser
POSTGRES_PASSWORD=StrongPass@2025
POSTGRES_DB=instagram_intel

# ── Redis Cache ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT Authentication ────────────────────────────────────
# ⚠️  CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-secret-min-32-chars-now
JWT_REFRESH_SECRET=change-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Services ───────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000

# ── Instagram Data (RapidAPI) ─────────────────────────────
# Get from: https://rapidapi.com/search/instagram
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISCOVERY_RATE_LIMIT_RPM=30

# ── Security ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12

# ── File Storage ──────────────────────────────────────────
EXPORT_DIR=./exports

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ── Integrations (Optional) ───────────────────────────────
SLACK_WEBHOOK_URL=
HUBSPOT_API_KEY=
ZAPIER_WEBHOOK_URL=
