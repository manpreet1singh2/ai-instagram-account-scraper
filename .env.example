# =============================================================
# AI Instagram Intelligence System - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── APPLICATION ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME="AI Instagram Intelligence"
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/instagram_intel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT AUTHENTICATION ──────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-min-32-characters
JWT_REFRESH_SECRET=change-this-to-another-random-secret-min-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI SERVICES ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000

# Optional: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ─── INSTAGRAM DATA SOURCES ──────────────────────────────────
# RapidAPI for public Instagram data
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISCOVERY_RATE_LIMIT_RPM=30

# ─── EMAIL (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ─── WEBHOOKS & INTEGRATIONS ─────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
HUBSPOT_API_KEY=your-hubspot-api-key

# ─── FILE STORAGE ────────────────────────────────────────────
EXPORT_DIR=./exports
MAX_EXPORT_SIZE_MB=100

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ─── SECURITY ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
SESSION_SECRET=another-random-secret-for-sessions

# ─── PROXY (Anti-detection) ──────────────────────────────────
# Optional: Rotating proxy for requests
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
USE_PROXY=false

# ─── SUBSCRIPTION PLANS ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
